# Copy to .env and adjust. Never commit real values.

# Backend bind
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Where job temp folders live (defaults to <system temp>/my_doctor_viewer_jobs)
# JOBS_ROOT=

# Max upload size per file, in MB
MAX_UPLOAD_MB=100

# LLM pipeline: auto | true | false
# auto   -> run MedGemma stages only if Ollama is reachable on 127.0.0.1:11434
# true   -> require Ollama (falls back with a warning if unreachable)
# false  -> deterministic text extraction only, no LLM stages
ENABLE_LLM=auto
OLLAMA_MODEL=MedGemma1.5:latest

# Hours a finished job's temp folder is kept before the startup sweep purges it
JOB_TTL_HOURS=24

# Comma-separated CORS origins ("*" is fine for local dev)
CORS_ORIGINS=*
